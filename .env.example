# ============================================
# MARCENARIA PRO - Environment Variables
# ============================================
# Backend API URL (Railway)
VITE_API_URL=https://gest-o-agenda-marcenaria-production.up.railway.app

# Database
DATABASE_URL=your_neon_database_url
JWT_SECRET=your_jwt_secretnciais reais!

# Este arquivo é um template. Copie para .env e preencha com seus valores reais.
# NUNCA compartilhe o arquivo .env com credenciais reais!

# ============================================
# DATABASE - Neon.tech PostgreSQL
# ============================================
# Connection string do Neon.tech (obrigatório)
# Formato: postgresql://user:password@host/database?sslmode=require
# Obtenha em: https://console.neon.tech → Seu projeto → Connection Details
DATABASE_URL=postgresql://username:password@ep-xxxxxxx.region.aws.neon.tech/neondb?sslmode=require

# ============================================
# SECURITY - Autenticação JWT
# ============================================
# Chave secreta para geração de tokens JWT (obrigatório)
# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MÍNIMO 32 caracteres em produção!
JWT_SECRET=sua_chave_secreta_super_forte_com_no_minimo_64_caracteres_aqui

# ============================================
# ENVIRONMENT
# ============================================
# Ambiente de execução: development, production, test
NODE_ENV=development

# Porta do servidor backend (opcional, padrão: 3000)
PORT=3000

# ============================================
# CLOUD STORAGE (Opcional)
# ============================================
# Google Cloud Storage para upload de arquivos
# Deixe em branco se não for usar
GCS_BUCKET_NAME=seu-bucket-name
GCS_PROJECT_ID=seu-project-id
GOOGLE_APPLICATION_CREDENTIALS=./caminho/para/servicekey.json

# ============================================
# EMAIL/SMTP (Opcional)
# ============================================
# Configurações para envio de emails
# Deixe em branco se não for usar
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-ou-app-password
SMTP_FROM=noreply@marcenaria.pro

# ============================================
# FRONTEND (Vite)
# ============================================
# URL do backend em produção
# Para desenvolvimento local, use o proxy do Vite (não precisa desta variável)
VITE_API_URL=https://seu-backend.vercel.app

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. DATABASE_URL e JWT_SECRET são OBRIGATÓRIOS
# 2. Em produção, use JWT_SECRET com 64+ caracteres
# 3. Nunca commite o arquivo .env no Git
# 4. Use variáveis de ambiente no Vercel para produção
# 5. NODE_ENV=production ativa otimizações e segurança extra
